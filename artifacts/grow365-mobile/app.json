{
  "expo": {
    "name": "Grow365",
    "slug": "grow365-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grow365-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.grow365.app"
    },
    "android": {
      "package": "net.grow365.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e6ed346c-2163-4f3e-9603-415ddaf4e106"
      }
    },
    "owner": "nadunchandrabahu"
  }
}
